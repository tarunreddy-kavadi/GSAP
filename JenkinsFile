pipeline {
  agent {
    docker {
      image 'mittu999/gsap_image:v1'
      args '--user root -v /var/run/docker.sock:/var/run/docker.sock' // mount Docker socket to access the host's Docker daemon
    }
  }
  stages {
    stage('Checkout') {
      steps {
        sh 'echo passed'
        git branch: 'main', url: 'https://github.com/tarunreddy-kavadi/GSAP'
      }
    }
    stage ('Install dependencies') {
        steps {
            sh 'npm install'
        }
    }
    stage('Build and Test') {
      steps {
        // sh 'ls -ltr'
        // build the project and create a JAR file
        // sh 'cd java-maven-sonar-argocd-helm-k8s/spring-boot-app && mvn clean package'
        sh 'npm run build'
      }
    }
    
        stage('Static Code Analysis') {
            environment {
                SONAR_URL = "http://34.201.116.83:9000"
            }
            steps {
                withCredentials([string(credentialsId: 'sonarqube', variable: 'SONARQUBE_SECRET')]) {
                    // We run a Docker container on the fly specifically to execute the scanner command
                    sh """
                        docker run --rm \
                          -v \$(pwd):/usr/src \
                          sonarsource/sonar-scanner-cli:latest \
                          -Dsonar.host.url=${SONAR_URL} \
                          -Dsonar.login=${SONAR_AUTH_TOKEN} \
                          -Dsonar.projectKey=gsap \
                          -Dsonar.projectName=GSAP \
                          -Dsonar.sources=. \
                          -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info
                    """
                }
            }
        }

    stage('Build and Push Docker Image') {
    environment {
        DOCKER_IMAGE = "mittu999/gsap_image:v1.${BUILD_NUMBER}"
        REGISTRY_CREDENTIALS = credentials('docker-cred')
    }
    steps {
        script {
            // 1. Build the image locally on the Jenkins agent
            sh "docker build -t ${DOCKER_IMAGE} ."
            
            // 2. Log in to Docker Hub and push using your saved 'docker-cred'
            docker.withRegistry('https://docker.io', 'docker-cred') {
                def dockerImage = docker.image("${DOCKER_IMAGE}")
                dockerImage.push()
            }
        }
    }
}

    stage('Update Deployment File') {
        environment {
            GIT_REPO_NAME = "GSAP"
            GIT_USER_NAME = "tarunreddy-kavadi"
        }
        steps {
            withCredentials([string(credentialsId: 'github', variable: 'GITHUB_TOKEN')]) {
                sh '''
                    git config user.email "tarunreddy.kavadi.79@gmail.com"
                    git config user.name "tarunreddy-kavadi"
                    BUILD_NUMBER=${BUILD_NUMBER}
                    sed -i "s/replaceImageTag/${BUILD_NUMBER}/g" deployment.yml
                    git add deployment.yml
                    git commit -m "Update deployment image to version ${BUILD_NUMBER}"
                    git push https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME} HEAD:main
                '''
            }
        }
    }
  }
}




